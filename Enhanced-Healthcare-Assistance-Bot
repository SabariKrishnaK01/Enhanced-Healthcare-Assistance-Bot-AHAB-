    def predict_disease(self, user_input):
        """Enhanced disease prediction with confidence scoring"""
        processed_input = self.preprocess_text(user_input)
        input_vector = self.vectorizer.transform([processed_input])
        
        # Get predictions and probabilities
        disease = self.classifier.predict(input_vector)[0]
        probabilities = self.classifier.predict_proba(input_vector)[0]
        
        # Get confidence score
        disease_classes = self.classifier.classes_
        disease_index = np.where(disease_classes == disease)[0][0]
        confidence = probabilities[disease_index]
        
        return disease, confidence
    
