    def preprocess_text(self, text):
        # Enhanced preprocessing
        stop_words = ['is', 'are', 'the', 'with', 'there', 'it', 'and', 'but', 
                     'they', 'this', 'that', 'then', 'will', 'should', 'has', 
                     'had', 'their', 'could', 'can', 'did', 'a', 'an', 'how', 'what', 'when', 'where']
        
        # Clean and normalize text
        text = re.sub(r'[^\w\s]', ' ', text.lower())
        words = text.split()
        filtered_words = [word for word in words if word not in stop_words and len(word) > 2]
        return ' '.join(filtered_words)
    
    def train_model(self):
        # Use TF-IDF for better feature extraction
        self.vectorizer = TfidfVectorizer(preprocessor=self.preprocess_text, ngram_range=(1, 2))
        X = self.vectorizer.fit_transform(self.questions)
        
        # Use Random Forest for better classification
        self.classifier = RandomForestClassifier(n_estimators=100, random_state=42)
        self.classifier.fit(X, self.labels)
    
    def validate_input(self, input_text, input_type="general"):
        """Enhanced input validation"""
        if not input_text or not input_text.strip():
            return False, "Please provide a valid input."
        
        if input_type == "age":
            if not input_text.isdigit() or not (0 < int(input_text) <= 120):
                return False, "Please enter a valid age between 1 and 120."
        
        elif input_type == "name":
            if len(input_text.strip()) < 2 or not re.match(r'^[a-zA-Z\s]+$', input_text.strip()):
                return False, "Please enter a valid name (letters only, minimum 2 characters)."
        
        elif input_type == "symptoms":
            if len(input_text.strip()) < 5:
                return False, "Please provide a more detailed description of your symptoms."
        
        return True, "Valid input."
    
    def get_temperature_input(self, prompt):
        """Enhanced temperature input with better validation"""
        attempts = 0
        max_attempts = 3
        
        while attempts < max_attempts:
            print(f"\n{prompt}")
            print("Examples: '38.5 C', '101.3 F', '37.2°C', '99.1°F'")
            temp_input = input("Temperature: ").strip().upper().replace('°', '')
            
            if not temp_input:
                print("❌ Please enter your temperature.")
                attempts += 1
                continue
            
            # Parse temperature
            match = re.match(r'(\d+\.?\d*)\s*([CF])', temp_input)
            if not match:
                print("❌ Please use format like '38.5 C' or '101.3 F'")
                attempts += 1
                continue
            
            try:
                value = float(match.group(1))
                unit = match.group(2)
                
                if unit == 'C':
                    if 30 <= value <= 45:  # Reasonable range in Celsius
                        fahrenheit = (value * 9/5) + 32
                        return value, fahrenheit, 'C'
                    else:
                        print("❌ Please enter a realistic body temperature (30-45°C)")
                else:  # Fahrenheit
                    if 86 <= value <= 113:  # Reasonable range in Fahrenheit
                        celsius = (value - 32) * 5/9
                        return celsius, value, 'F'
                    else:
                        print("❌ Please enter a realistic body temperature (86-113°F)")
                
                attempts += 1
            except ValueError:
                print("❌ Please enter a valid number for temperature.")
                attempts += 1
        
        print("❌ Maximum attempts reached. Using default temperature assessment.")
        return None, None, None
    
    def assess_severity(self, symptoms_text, temperature=None):
        """Assess symptom severity based on description and temperature"""
        severity_score = 0
        text_lower = symptoms_text.lower()
        
        # Check for severity keywords
        for severity, keywords in self.severity_indicators.items():
            for keyword in keywords:
                if keyword in text_lower:
                    if severity == 'high':
                        severity_score += 3
                    elif severity == 'medium':
                        severity_score += 2
                    else:
                        severity_score += 1
        
        # Temperature-based severity
        if temperature:
            celsius_temp = temperature[0] if temperature[0] else 37
            if celsius_temp >= 39.5:  # 103°F
                severity_score += 3
            elif celsius_temp >= 38.5:  # 101.3°F
                severity_score += 2
            elif celsius_temp >= 37.8:  # 100°F
                severity_score += 1
        
        # Determine severity level
        if severity_score >= 5:
            return 'severe'
        elif severity_score >= 3:
            return 'moderate'
        else:
            return 'mild'
    
